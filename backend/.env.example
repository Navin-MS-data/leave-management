# Copy to .env and fill in. Never commit .env.

# Neon: use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Neon: use the DIRECT (non-pooled) connection string for schema sync and seeding.
# Optional - falls back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Optional: a separate (empty) database or Neon branch for tests.
# When unset, tests run on an in-memory Postgres (pg-mem).
# DATABASE_URL_TEST=

# A long random string, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Create/update tables automatically on app start (true for dev, set false in production).
DB_SYNCHRONIZE=true
